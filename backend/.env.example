# ============================================================
# API Keys
# ============================================================
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # only needed for evaluation
PINECONE_API_KEY=your_pinecone_api_key_here

# ============================================================
# Pinecone Configuration
# ============================================================
PINECONE_INDEX_NAME=scientific-papers
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ============================================================
# Redis Configuration
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# Model Configuration (optional overrides)
# ============================================================
# LLM_MODEL=models/gemini-3.5-flash-lite
# JUDGE_LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=BAAI/bge-m3

# ============================================================
# Deployment
# ============================================================
# DEMO_MODE=true          # disables /evaluate and document deletion
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # in production: the Vercel frontend URL, e.g. https://scichat.vercel.app
